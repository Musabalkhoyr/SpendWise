# GEMINI_API_KEY or GOOGLE_API_KEY: Required for Gemini/Gemma AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GOOGLE_API_KEY="MY_GOOGLE_API_KEY"

# Configurable Gemma/Gemini Model ID (defaults to gemini-3.8-flash; can be set to gemma-3-27b-it, gemini-4-argon, etc.)
GEMMA_MODEL_ID="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database and Session Secrets
DATABASE_URL="file:./data/spendwise.db.json"
SESSION_SECRET="spendwise_secure_session_secret_2026"
PORT=3000
